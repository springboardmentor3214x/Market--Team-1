# Copy to .env  (copy .env.example .env)
# Default is SQLite so it runs with zero setup. For PostgreSQL use e.g.:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/market_research
DATABASE_URL=sqlite:///./market_data.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Yahoo search can be switched off (then only the built-in company list is used)
ENABLE_YAHOO_SEARCH=true
